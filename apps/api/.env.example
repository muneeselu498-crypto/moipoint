# Copy this file to .env. Real keys go in .env, which git ignores. Never paste them in a chat.

# --- Database and server ---
DATABASE_URL="postgresql://moipoint@localhost:5544/moipoint"
PORT=4600
# 0.0.0.0 lets phones on the same Wi-Fi reach it. Use 127.0.0.1 to keep it on this laptop only.
HOST=0.0.0.0
TZ=Asia/Kolkata
PUBLIC_URL=http://localhost:4600

# --- Testing tools ---
# 1 turns on the Dev Outbox at /dev/outbox and shows OTP codes on screen.
# Must be 0 on a real server.
DEV_TOOLS=1
# 1 loads the demo accounts when the database is empty.
SEED_DEMO=1

# --- Messages: WhatsApp, SMS and email ---
# dev     = nothing leaves this computer; everything shows in the Dev Outbox
# webhook = every message is POSTed to MESSAGE_WEBHOOK_URL, for the automation team's system
MESSAGE_PROVIDER=dev
MESSAGE_WEBHOOK_URL=
# Sent as a header on outgoing webhooks, and required on incoming delivery reports.
MESSAGE_WEBHOOK_SECRET=

# How many proxies sit in front of this server, such as nginx. Leave at 0 unless one really does,
# or callers could fake their address and get around the rate limits.
TRUST_PROXY=0

# --- Payments for message credits ---
# simulate = no real money moves. Only for testing.
PAYMENT_PROVIDER=simulate

# --- Moi Book PDF ---
# Path to Chrome or Edge. Left empty, the app looks in the usual places.
CHROME_PATH=
